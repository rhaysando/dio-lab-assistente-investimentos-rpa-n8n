{
  "name": "Assistente de Investimentos RPA + IA",
  "nodes": [
    {
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "clientes",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Busca CSV investimentos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://digitalinnovationone.github.io/dio-lab-assistente-investimentos-rpa-n8n/data.csv",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "3",
      "name": "Normaliza CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const texto = $input.first().json.data || '';\nconst linhas = texto.trim().split(/\\r?\\n/);\nconst cab = linhas.shift().split(',').map(h => h.trim().toLowerCase());\nreturn linhas.map(l => {\n  const v = l.split(',');\n  const o = {};\n  cab.forEach((h, i) => o[h] = (v[i] || '').trim());\n  o.minimo = Number(String(o.minimo).replace(/[^0-9.]/g, '')) || 0;\n  o.rentabilidade_texto = o.rentabilidade;               // ex.: 12.5%, IPCA+6.0%, Variável\n  const num = String(o.rentabilidade).match(/[0-9]+(\\.[0-9]+)?/);\n  o.rentabilidade_ordem = num ? Number(num[0]) : 0;      // usado só para ordenar\n  return { json: o };\n});"
      }
    },
    {
      "id": "4",
      "name": "Match e mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const clientes = $('Webhook').first().json.body.clientes || [];\nconst invest = $('Normaliza CSV').all().map(i => i.json);\nreturn clientes.map(c => {\n  const opcoes = invest\n    .filter(i => i.perfil.toLowerCase() === String(c.perfil).toLowerCase() && Number(c.saldo) >= i.minimo)\n    .sort((a, b) => b.rentabilidade_ordem - a.rentabilidade_ordem);\n  const melhor = opcoes[0] || null;\n  const primeiroNome = String(c.nome).split(' ')[0];\n  const mensagem = melhor\n    ? `Olá, ${primeiroNome}! Pelo seu perfil ${c.perfil}, uma boa opção é ${melhor.produto} (aplicação mínima de R$ ${melhor.minimo}, rentabilidade de referência: ${melhor.rentabilidade_texto}). Seu saldo atual já permite investir.`\n    : `Olá, ${primeiroNome}! Ainda não encontramos uma opção compatível com seu perfil e saldo. Fale com seu assessor.`;\n  return { json: { nome: c.nome, email: c.email, perfil: c.perfil, saldo: c.saldo, produto: melhor?.produto || null, minimo: melhor?.minimo || null, rentabilidade: melhor?.rentabilidade_texto || null, mensagem } };\n});"
      }
    },
    {
      "id": "5",
      "name": "OpenAI e-mail",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "={{ `Escreva um e-mail curto, em português do Brasil, para o cliente abaixo. Não prometa ganhos nem garanta rentabilidade. Tom próximo e profissional. Responda APENAS em JSON com as chaves subject e body.\nCliente: ${$json.nome}\nPerfil: ${$json.perfil}\nSaldo: R$ ${$json.saldo}\nSugestão: ${$json.produto} (mínimo R$ ${$json.minimo}, referência ${$json.rentabilidade})` }}"
            }
          ]
        },
        "options": {}
      },
      "retryOnFail": true
    },
    {
      "id": "6",
      "name": "Normaliza resposta LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, idx) => {\n  const base = $('Match e mensagem').all()[idx].json;\n  let txt = item.json.message?.content || item.json.text || '';\n  let obj = {};\n  try { obj = JSON.parse(txt); } catch (e) { obj = { subject: 'Sugestão de investimento para o seu perfil', body: txt }; }\n  const body = String(obj.body || '').replace(/\\n/g, '<br>');\n  return { json: { to: String(base.email || '').trim().toLowerCase(), subject: obj.subject, html: body, nome: base.nome } };\n});"
      }
    },
    {
      "id": "7",
      "name": "E-mail valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.to }}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8",
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1540,
        -100
      ],
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9",
      "name": "Lista invalidos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a",
              "name": "invalido",
              "value": "={{ $json.nome }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "10",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"processados\": $input.all().length } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Busca CSV investimentos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Busca CSV investimentos": {
      "main": [
        [
          {
            "node": "Normaliza CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normaliza CSV": {
      "main": [
        [
          {
            "node": "Match e mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Match e mensagem": {
      "main": [
        [
          {
            "node": "OpenAI e-mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI e-mail": {
      "main": [
        [
          {
            "node": "Normaliza resposta LLM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normaliza resposta LLM": {
      "main": [
        [
          {
            "node": "E-mail valido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "E-mail valido?": {
      "main": [
        [
          {
            "node": "Gmail",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Lista invalidos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lista invalidos": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}